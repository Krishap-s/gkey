# udev rules for gkey.
#
# Let members of the 'gkey' group create virtual HID devices, so that
# gkey-service can run as an ordinary user.  Note that any program run
# by such a user can then create arbitrary HID devices (keyboards
# included), so only add users who should be trusted with that.
#
# The FIDO device that gkey-service creates is made accessible to the
# logged in user by systemd's 60-fido-id.rules.

KERNEL=="uhid", SUBSYSTEM=="misc", GROUP="gkey", MODE="0660"
