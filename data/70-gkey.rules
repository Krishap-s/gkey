# udev rules for gkey.
#
# Let the 'gkey' account, which gkey-service runs as, create virtual
# HID devices.  Do not add people to the 'gkey' group: it would let
# their programs create arbitrary HID devices, keyboards included.
#
# The FIDO device that gkey-service creates is made accessible to the
# user of the active session by systemd's 60-fido-id.rules.

KERNEL=="uhid", SUBSYSTEM=="misc", GROUP="gkey", MODE="0660"
