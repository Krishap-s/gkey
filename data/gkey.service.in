# systemd user unit for gkey-service.
#
# Enable it with: systemctl --user enable --now gkey.service

[Unit]
Description=gkey TPM backed FIDO2 authenticator
Documentation=info:gkey
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# gkey-service relies on being set-group-ID @GKEY_GROUP@ to use the TPM.
# Do not set NoNewPrivileges=, or options that imply it in user units
# (SystemCallFilter=, RestrictNamespaces=, ProtectKernel*= and so on):
# the kernel would then ignore the set-group-ID bit.
ExecStart=@bindir@/gkey-service
Restart=on-failure

[Install]
WantedBy=graphical-session.target
