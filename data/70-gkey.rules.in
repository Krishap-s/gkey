# udev rules for gkey.
#
# gkey-service and gkey are installed set-user-ID @GKEY_USER@.  Only
# that account may create virtual HID devices and use the TPM, so that
# programs running as the user, malware included, can do neither.
#
# The FIDO device that gkey-service creates is made accessible to the
# logged in user by systemd's 60-fido-id.rules.

KERNEL=="uhid", SUBSYSTEM=="misc", OWNER="@GKEY_USER@", MODE="0600"

# Grant the TPM resource manager to the account with an ACL, keeping
# the distribution's own permissions (usually group tss) in place.
KERNEL=="tpmrm[0-9]*", SUBSYSTEM=="tpmrm", RUN+="@SETFACL@ -m u:@GKEY_USER@:rw /dev/%k"
