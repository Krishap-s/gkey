# The targets follow the GNU Coding Standards, see
# <https://www.gnu.org/prep/standards/html_node/Standard-Targets.html>.

SHELL = /bin/sh

PACKAGE = @PACKAGE_TARNAME@
VERSION = @PACKAGE_VERSION@
distdir = $(PACKAGE)-$(VERSION)

srcdir = @srcdir@
abs_builddir = @abs_builddir@
abs_srcdir = @abs_srcdir@

prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
datarootdir = @datarootdir@
datadir = @datadir@
sysconfdir = @sysconfdir@
infodir = @infodir@
docdir = @docdir@
htmldir = @htmldir@
dvidir = @dvidir@
pdfdir = @pdfdir@
psdir = @psdir@
systemduserunitdir = @systemduserunitdir@
sysusersdir = @sysusersdir@
udevrulesdir = @udevrulesdir@
modulesloaddir = @modulesloaddir@
polkitactiondir = @polkitactiondir@

CARGO = @CARGO@
CARGOFLAGS =
CARGO_TARGET_DIR = $(abs_builddir)/target
MAKEINFO = @MAKEINFO@
TEXI2DVI = @TEXI2DVI@
INSTALL_INFO = @INSTALL_INFO@
DVIPS = dvips
ETAGS = ctags -e
INSTALL = install
INSTALL_PROGRAM = $(INSTALL)
INSTALL_DATA = $(INSTALL) -m 644
PYTHON3 = python3
SETFACL = @SETFACL@
SYSTEMD_SYSUSERS = systemd-sysusers

# The programs are installed owned by this account, mode 4755:
# set-user-ID, so that they alone can use the TPM and /dev/uhid, and
# describe requests in polkit's dialog as the owner of its actions.
GKEY_USER = @GKEY_USER@

PROGRAMS = gkey gkey-service
RELEASE = $(CARGO_TARGET_DIR)/release
BINARIES = $(RELEASE)/gkey $(RELEASE)/gkey-service
# Every cargo invocation must see the same environment, or cargo
# rebuilds the crate each time it changes.
CARGO_ENV = GKEY_USER='$(GKEY_USER)'
CARGO_BUILD = $(CARGO_ENV) $(CARGO) build --release --manifest-path $(srcdir)/Cargo.toml \
	--target-dir $(CARGO_TARGET_DIR) $(CARGOFLAGS)

DISTFILES = AUTHORS COPYING ChangeLog DESIGN.md INSTALL NEWS README.md \
	Cargo.toml Cargo.lock Makefile.in configure configure.ac \
	default.nix flake.nix flake.lock \
	data/70-gkey.rules.in data/gkey.sysusers.in data/gkey-modules.conf \
	data/gkey.service.in \
	data/io.github.krishap_s.gkey.policy.in \
	doc/gkey.texi doc/gkey.info doc/version.texi

.PHONY: all build install install-strip installdirs uninstall clean mostlyclean \
	distclean maintainer-clean check installcheck dist info dvi html pdf ps \
	install-info install-dvi install-html install-pdf install-ps install-setuid TAGS

GENERATED = gkey.service 70-gkey.rules gkey.sysusers io.github.krishap_s.gkey.policy

all: $(BINARIES) $(GENERATED)

# The binaries are real targets, so that 'make install' after 'make'
# does not run cargo again: run as root, cargo would use root's home
# directory and rebuild everything.  cargo lists the sources of each
# binary in a dependency file next to it.
$(BINARIES): $(srcdir)/Cargo.toml $(srcdir)/Cargo.lock Makefile
	$(CARGO_BUILD) --bins
	touch $@

-include $(RELEASE)/gkey.d
-include $(RELEASE)/gkey-service.d

# Run cargo whatever make thinks.
build:
	$(CARGO_BUILD) --bins

SUBSTITUTE = sed -e 's|@bindir[@]|$(bindir)|g' -e 's|@GKEY_USER[@]|$(GKEY_USER)|g' \
	-e 's|@SETFACL[@]|$(SETFACL)|g'

gkey.service: $(srcdir)/data/gkey.service.in Makefile
	$(SUBSTITUTE) $(srcdir)/data/gkey.service.in > $@.tmp
	mv $@.tmp $@

70-gkey.rules: $(srcdir)/data/70-gkey.rules.in Makefile
	$(SUBSTITUTE) $(srcdir)/data/70-gkey.rules.in > $@.tmp
	mv $@.tmp $@

gkey.sysusers: $(srcdir)/data/gkey.sysusers.in Makefile
	$(SUBSTITUTE) $(srcdir)/data/gkey.sysusers.in > $@.tmp
	mv $@.tmp $@

io.github.krishap_s.gkey.policy: $(srcdir)/data/io.github.krishap_s.gkey.policy.in Makefile
	$(SUBSTITUTE) $(srcdir)/data/io.github.krishap_s.gkey.policy.in > $@.tmp
	mv $@.tmp $@

installdirs:
	mkdir -p $(DESTDIR)$(bindir) $(DESTDIR)$(systemduserunitdir) \
	  $(DESTDIR)$(sysusersdir) $(DESTDIR)$(udevrulesdir) $(DESTDIR)$(modulesloaddir) \
	  $(DESTDIR)$(polkitactiondir)

install: all installdirs
	for p in $(PROGRAMS); do \
	  $(INSTALL_PROGRAM) $(RELEASE)/$$p $(DESTDIR)$(bindir)/$$p || exit 1; \
	done
	$(INSTALL_DATA) gkey.service $(DESTDIR)$(systemduserunitdir)/gkey.service
	$(INSTALL_DATA) gkey.sysusers $(DESTDIR)$(sysusersdir)/gkey.conf
	$(INSTALL_DATA) 70-gkey.rules $(DESTDIR)$(udevrulesdir)/70-gkey.rules
	$(INSTALL_DATA) $(srcdir)/data/gkey-modules.conf $(DESTDIR)$(modulesloaddir)/gkey.conf
	$(INSTALL_DATA) io.github.krishap_s.gkey.policy \
	  $(DESTDIR)$(polkitactiondir)/io.github.krishap_s.gkey.policy
	@if test -f doc/gkey.info || test -f $(srcdir)/doc/gkey.info; then \
	  $(MAKE) install-info; \
	fi
	@$(MAKE) install-setuid

# Make the programs set-user-ID.  This needs root and an existing
# account; when installing into a staging directory (DESTDIR), or as
# an ordinary user, say what remains to be done instead.  chown comes
# first, since it clears the set-user-ID bit.
install-setuid:
	@programs='$(DESTDIR)$(bindir)/gkey $(DESTDIR)$(bindir)/gkey-service'; \
	if test "`id -u`" = 0 && test -z '$(DESTDIR)'; then \
	  if ! id '$(GKEY_USER)' > /dev/null 2>&1; then \
	    $(SYSTEMD_SYSUSERS) $(sysusersdir)/gkey.conf || exit 1; \
	  fi; \
	  chown '$(GKEY_USER):$(GKEY_USER)' $$programs && chmod 4755 $$programs; \
	else \
	  echo "*** The programs must be set-user-ID $(GKEY_USER).  As root, run:"; \
	  echo "***   systemd-sysusers $(sysusersdir)/gkey.conf"; \
	  echo "***   chown $(GKEY_USER):$(GKEY_USER) $(bindir)/gkey $(bindir)/gkey-service"; \
	  echo "***   chmod 4755 $(bindir)/gkey $(bindir)/gkey-service"; \
	fi

install-strip:
	$(MAKE) INSTALL_PROGRAM='$(INSTALL_PROGRAM) -s' install

uninstall:
	for p in $(PROGRAMS); do rm -f $(DESTDIR)$(bindir)/$$p; done
	rm -f $(DESTDIR)$(systemduserunitdir)/gkey.service
	rm -f $(DESTDIR)$(sysusersdir)/gkey.conf
	rm -f $(DESTDIR)$(udevrulesdir)/70-gkey.rules
	rm -f $(DESTDIR)$(modulesloaddir)/gkey.conf
	rm -f $(DESTDIR)$(polkitactiondir)/io.github.krishap_s.gkey.policy
	-$(INSTALL_INFO) --delete --info-dir=$(DESTDIR)$(infodir) \
	  $(DESTDIR)$(infodir)/gkey.info 2>/dev/null
	rm -f $(DESTDIR)$(infodir)/gkey.info

# Documentation.

TEXI_DEPS = $(srcdir)/doc/gkey.texi doc/version.texi

doc/version.texi: $(srcdir)/Cargo.toml
	mkdir -p doc
	{ echo '@set VERSION $(VERSION)'; \
	  echo "@set UPDATED `date -u -r $(srcdir)/doc/gkey.texi '+%B %Y' 2>/dev/null || date -u '+%B %Y'`"; \
	} > $@

info: doc/gkey.info
doc/gkey.info: $(TEXI_DEPS)
	$(MAKEINFO) -I doc --no-split -o $@ $(srcdir)/doc/gkey.texi

html: doc/gkey.html
doc/gkey.html: $(TEXI_DEPS)
	$(MAKEINFO) -I doc --html --no-split -o $@ $(srcdir)/doc/gkey.texi

dvi: doc/gkey.dvi
doc/gkey.dvi: $(TEXI_DEPS)
	cd doc && $(TEXI2DVI) --batch -o gkey.dvi $(abs_srcdir)/doc/gkey.texi

pdf: doc/gkey.pdf
doc/gkey.pdf: $(TEXI_DEPS)
	cd doc && $(TEXI2DVI) --batch --pdf -o gkey.pdf $(abs_srcdir)/doc/gkey.texi

ps: doc/gkey.ps
doc/gkey.ps: doc/gkey.dvi
	$(DVIPS) -o $@ doc/gkey.dvi

install-info: info
	mkdir -p $(DESTDIR)$(infodir)
	if test -f doc/gkey.info; then d=doc; else d=$(srcdir)/doc; fi; \
	$(INSTALL_DATA) $$d/gkey.info $(DESTDIR)$(infodir)/gkey.info
	-$(INSTALL_INFO) --info-dir=$(DESTDIR)$(infodir) $(DESTDIR)$(infodir)/gkey.info

install-html: html
	mkdir -p $(DESTDIR)$(htmldir)
	$(INSTALL_DATA) doc/gkey.html $(DESTDIR)$(htmldir)/gkey.html

install-dvi: dvi
	mkdir -p $(DESTDIR)$(dvidir)
	$(INSTALL_DATA) doc/gkey.dvi $(DESTDIR)$(dvidir)/gkey.dvi

install-pdf: pdf
	mkdir -p $(DESTDIR)$(pdfdir)
	$(INSTALL_DATA) doc/gkey.pdf $(DESTDIR)$(pdfdir)/gkey.pdf

install-ps: ps
	mkdir -p $(DESTDIR)$(psdir)
	$(INSTALL_DATA) doc/gkey.ps $(DESTDIR)$(psdir)/gkey.ps

# Testing.

# Runs the unit tests and, when swtpm is installed, the tests that
# need a TPM against a temporary software TPM.
# The tests are built in the release profile, with the same
# environment as the programs, to reuse what 'make' built.
check: $(BINARIES)
	$(CARGO_ENV) CARGO='$(CARGO)' CARGO_TARGET_DIR='$(CARGO_TARGET_DIR)' \
	  CARGOFLAGS='$(CARGOFLAGS)' PYTHON3='$(PYTHON3)' srcdir='$(srcdir)' \
	  $(SHELL) $(srcdir)/tests/run-tests.sh

installcheck:
	for p in $(PROGRAMS); do \
	  $(DESTDIR)$(bindir)/$$p --version > /dev/null || exit 1; \
	  $(DESTDIR)$(bindir)/$$p --help > /dev/null || exit 1; \
	done

# Distribution.

dist: info
	rm -rf $(distdir)
	mkdir -p $(distdir)/data $(distdir)/doc $(distdir)/tests
	cp -R $(srcdir)/src $(distdir)/
	mkdir -p $(distdir)/tests/helpers
	cp $(srcdir)/tests/helpers/*.rs $(distdir)/tests/helpers/
	cp $(srcdir)/tests/*.rs $(srcdir)/tests/*.py $(srcdir)/tests/*.sh $(distdir)/tests/
	for f in $(DISTFILES); do \
	  if test -f $$f; then cp $$f $(distdir)/$$f; \
	  else cp $(srcdir)/$$f $(distdir)/$$f; fi || exit 1; \
	done
	tar chof - $(distdir) | gzip -9 -c > $(distdir).tar.gz
	rm -rf $(distdir)

TAGS:
	$(ETAGS) -R -f TAGS $(srcdir)/src $(srcdir)/tests

# Cleaning.

mostlyclean:
	rm -f $(GENERATED) *.tmp
	rm -f doc/gkey.html doc/gkey.dvi doc/gkey.pdf doc/gkey.ps
	rm -f doc/*.aux doc/*.cp doc/*.cps doc/*.fn doc/*.ky doc/*.log doc/*.pg \
	  doc/*.toc doc/*.tp doc/*.vr

clean: mostlyclean
	$(CARGO) clean --manifest-path $(srcdir)/Cargo.toml --target-dir $(CARGO_TARGET_DIR)
	rm -f $(distdir).tar.gz

distclean: clean
	rm -f Makefile config.status config.log TAGS
	rm -rf autom4te.cache

maintainer-clean: distclean
	@echo 'This command is intended for maintainers to use; it'
	@echo 'deletes files that may need special tools to rebuild.'
	rm -f configure doc/gkey.info doc/version.texi

Makefile: $(srcdir)/Makefile.in config.status
	./config.status Makefile

config.status: $(srcdir)/configure
	./config.status --recheck
